{
  "name": "subway-map-studio",
  "private": true,
  "version": "0.0.0",
  "description": "在真实地图瓦片上绘制地铁线路图的单文件应用（双击即用 + 局域网存档）",
  "scripts": {
    "check": "node scratch/syntax.js",
    "test:link": "node scratch/link-plan.js",
    "test:nav": "node scratch/nav-plan.js && node scratch/nav-playback-test.js",
    "test:speech": "node scratch/nav-speech-test.js && node scratch/speech-name-test.js",
    "test:curve": "node scratch/curve-edit-test.js && node scratch/curve-export-test.js",
    "test:labels": "node scratch/zoom-label-test.js",
    "build:pages": "node scratch/build-pages.js",
    "sync": "node scratch/sync.js",
    "start": "node server.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
